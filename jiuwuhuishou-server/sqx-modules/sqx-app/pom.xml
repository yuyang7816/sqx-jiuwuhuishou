                                <include>com/sqx/app/base/auth/support/AppAuthTokenSupport.class</include>
                                <include>com/sqx/app/base/file/service/impl/FileServiceImpl.class</include>
                                <include>com/sqx/app/base/map/service/impl/MapServiceImpl.class</include>
                                <include>com/sqx/app/base/notification/core/service/impl/NotificationServiceImpl.class</include>
                                <include>com/sqx/app/base/notification/service/impl/NotifyServiceImpl.class</include>
                                <include>com/sqx/app/base/pay/business/service/impl/BusinessServiceImpl.class</include>
                                <include>com/sqx/app/base/pay/business/service/impl/PayNotifyBusinessServiceImpl.class</include>
                                <include>com/sqx/app/base/pay/business/service/impl/VipPayServiceImpl.class</include>
                                <include>com/sqx/app/base/template/service/impl/SmsTemplateServiceImpl.class</include>
                                <include>com/sqx/app/base/user/service/impl/UserServiceImpl.class</include>
                                <include>com/sqx/app/base/verifyCode/service/impl/VerifyCodeServiceImpl.class</include>
                                <include>com/sqx/app/product/support/ProductRecycleSupport.class</include>
                                <include>com/sqx/app/recycle/config/service/impl/RecycleConfigServiceImpl.class</include>
                            </includes>
                            <rules>
                                <rule>
                                    <element>CLASS</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>