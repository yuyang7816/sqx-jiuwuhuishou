<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.sqx</groupId>
        <artifactId>sqx-modules</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>sqx-app</artifactId>

    <properties>
        <!-- 与 docs/testing/jacoco-gate-includes.txt 同步；空门禁时保持 parent jacoco.check.skip=true -->
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.sqx</groupId>
            <artifactId>sqx-common-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.sqx</groupId>
            <artifactId>sqx-common-pay</artifactId>
        </dependency>

        <dependency>
            <groupId>com.sqx</groupId>
            <artifactId>sqx-common-doc</artifactId>
        </dependency>

        <dependency>
            <groupId>com.sqx</groupId>
            <artifactId>sqx-common-mail</artifactId>
        </dependency>

        <dependency>
            <groupId>com.sqx</groupId>
            <artifactId>sqx-common-sms</artifactId>
        </dependency>

        <dependency>
            <groupId>com.sqx</groupId>
            <artifactId>sqx-common-file</artifactId>
        </dependency>

        <dependency>
            <groupId>com.sqx</groupId>
            <artifactId>sqx-common-shiro</artifactId>
        </dependency>

        <dependency>
            <groupId>com.sqx</groupId>
            <artifactId>sqx-common-websocket</artifactId>
        </dependency>

        <dependency>
            <groupId>com.sqx</groupId>
            <artifactId>sqx-common-mybatis</artifactId>
        </dependency>

        <dependency>
            <groupId>com.sqx</groupId>
            <artifactId>sqx-system</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>${okhttp3.version}</version>
        </dependency>

        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-core</artifactId>
        </dependency>

        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-crypto</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-inline</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <!-- 业务层报告范围：见 docs/testing/coverage-include-exclude.md；须带 .class -->
                            <includes>
                                <include>**/service/impl/*ServiceImpl.class</include>
                                <include>**/support/**</include>
                                <include>**/express/sf/SfExpressOrderService.class</include>
                                <include>**/express/sf/SfButlerClient.class</include>
                            </includes>
                            <excludes>
                                <exclude>**/domain/**</exclude>
                                <exclude>**/entity/**</exclude>
                                <exclude>**/bo/**</exclude>
                                <exclude>**/vo/**</exclude>
                                <exclude>**/db/mapper/**</exclude>
                                <exclude>**/db/service/impl/**</exclude>
                                <exclude>**/controller/**</exclude>
                                <!-- 不再排除 **/config/**：会误伤 recycle/config 业务 Service；Spring *Config 本就不在 include 内 -->
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <skip>${jacoco.check.skip}</skip>
                            <!-- 渐进门禁：仅检查 gate 内类；路径须带 .class；同步 docs/testing/jacoco-gate-includes.txt -->
                            <includes>
                                <include>com/sqx/app/order/support/RecycleOrderStateMachine.class</include>
                                <include>com/sqx/app/order/service/impl/RecycleOrderServiceImpl.class</include>
                                <include>com/sqx/app/order/service/impl/AppointmentOptionServiceImpl.class</include>
                                <include>com/sqx/app/recycle/appliance/service/impl/ApplianceRecycleServiceImpl.class</include>
                                <include>com/sqx/app/recycle/appliance/support/ApplianceEstimateRuleSupport.class</include>
                                <include>com/sqx/app/recycle/appliance/support/ApplianceHeroFlowDefaults.class</include>
                                <include>com/sqx/app/recycle/appliance/support/ApplianceSpecDefaults.class</include>
                                <include>com/sqx/app/recycle/book/service/impl/BookRecycleServiceImpl.class</include>
                                <include>com/sqx/app/recycle/book/support/BookEstimateDefaults.class</include>
                                <include>com/sqx/app/recycle/book/support/BookCategoryDefaults.class</include>
