                                <include>com/sqx/app/admin/recycle/appliance/service/impl/AdminApplianceManageServiceImpl.class</include>
                                <include>com/sqx/app/admin/recycle/book/service/impl/AdminBookManageServiceImpl.class</include>
                                <include>com/sqx/app/admin/recycle/clothes/service/impl/AdminClothesManageServiceImpl.class</include>
                                <include>com/sqx/app/admin/recycle/digital/service/impl/AdminDigitalManageServiceImpl.class</include>
