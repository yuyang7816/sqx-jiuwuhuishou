                                <include>com/sqx/app/recycle/clothes/support/ClothesCategoryDefaults.class</include>
                                <include>com/sqx/app/recycle/digital/service/impl/DigitalRecycleServiceImpl.class</include>
                                <include>com/sqx/app/recycle/digital/support/DigitalSpecDefaults.class</include>
                                <include>com/sqx/app/pickup/service/impl/PickupTaskAssignServiceImpl.class</include>
                                <include>com/sqx/app/pickup/service/impl/PickupTaskServiceImpl.class</include>
                                <include>com/sqx/app/settlement/service/impl/SettlementServiceImpl.class</include>
                                <include>com/sqx/app/payout/service/impl/PayoutServiceImpl.class</include>
                                <include>com/sqx/app/review/service/impl/ReviewServiceImpl.class</include>
                                <include>com/sqx/app/wallet/wallet/service/impl/UserWalletServiceImpl.class</include>
                                <include>com/sqx/app/wallet/transaction/service/impl/UserWalletTransactionServiceImpl.class</include>
                                <include>com/sqx/app/referral/withdraw/service/impl/WithdrawRecordServiceImpl.class</include>
                                <include>com/sqx/app/referral/withdraw/service/impl/WithdrawalAccountServiceImpl.class</include>
                                <include>com/sqx/app/referral/commission/service/impl/ReferralCommissionServiceImpl.class</include>
                                <include>com/sqx/app/referral/user/service/impl/ReferralUserCommissionServiceImpl.class</include>
                                <include>com/sqx/app/welfare/service/impl/WelfareServiceImpl.class</include>
                                <include>com/sqx/app/admin/ops/service/impl/AdminWelfareTaskManageServiceImpl.class</include>
                                <include>com/sqx/app/vip/plan/service/impl/VipPlanServiceImpl.class</include>
                                <include>com/sqx/app/vip/rights/service/impl/VipRightsServiceImpl.class</include>
                                <include>com/sqx/app/base/banner/service/impl/BannerServiceImpl.class</include>
